server {
    listen 443 ssl http2;
    server_name feishu-agent.example.com;

    ssl_certificate     /etc/letsencrypt/live/feishu-agent.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/feishu-agent.example.com/privkey.pem;
    client_max_body_size 1m;

    # Public plane: Feishu ingress, OAuth, health/readiness and the authenticated
    # /admin + /api/admin/v1 setup/management surface. Keep TLS enabled because
    # the management session cookie is always Secure.
    location / {
        proxy_pass http://127.0.0.1:7860;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        # The application may trust this header only when the socket peer is
        # listed in ADMIN_TRUSTED_PROXY_ADDRESSES (127.0.0.1,::1 here).
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 60s;
    }

    # 127.0.0.1:8788 is deliberately not proxied and remains platform-local.
}
