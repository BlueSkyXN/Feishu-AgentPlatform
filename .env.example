# Feishu Agent Platform 0.1.0
# 真实 Secret 只写入本地 .env、部署 Secret 或 Hugging Face Space Secrets。

# 首次启动 / 管理台
# ADMIN_TOKEN 同时用于 Internal Bearer 认证与 /admin bootstrap 登录。
# PLATFORM_MASTER_KEY 用于 AES-GCM Credential Vault；必须独立备份，不能提交。
ADMIN_TOKEN=replace-with-openssl-rand-hex-32
PLATFORM_MASTER_KEY=replace-with-openssl-rand-hex-32
# 需要 admin 审批的高风险工具操作，只允许这些飞书 open_id 点击批准。
ADMIN_OPEN_IDS=
TOOL_APPROVAL_TTL_MS=300000

# Feishu Apps（可在 setup mode 中通过 /admin 配置 Vault；环境变量也可用于受控 seed）
FEISHU_PRIMARY_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_PRIMARY_APP_SECRET=replace-me
FEISHU_PRIMARY_VERIFICATION_TOKEN=replace-me
FEISHU_PRIMARY_ENCRYPT_KEY=

# `secondary` App 示例默认关闭；启用对应 App 和 Binding 后再配置下列值。
FEISHU_SECONDARY_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_SECONDARY_APP_SECRET=replace-me

# Host Model Broker -> Cloudflare AI Gateway
CLOUDFLARE_ACCOUNT_ID=replace-me
CLOUDFLARE_GATEWAY_ID=replace-me
CLOUDFLARE_API_KEY=replace-with-ai-gateway-run-token
# 可选：覆盖由 account/gateway 自动拼出的上游根地址。
# MODEL_BROKER_UPSTREAM_BASE_URL=https://gateway.ai.cloudflare.com/v1/account/gateway
MODEL_BROKER_ENABLED=true
MODEL_BROKER_HOST=127.0.0.1
MODEL_BROKER_PORT=8790
MODEL_BROKER_REQUEST_TIMEOUT_MS=300000
MODEL_BROKER_MAX_BODY_BYTES=20971520
MODEL_CAPABILITY_TTL_MS=900000
MODEL_CAPABILITY_MAX_LIFETIME_MS=21600000
# 仅限受控开发联调；生产保持 false，强制 Cloudflare Gateway host。
MODEL_BROKER_ALLOW_NON_CLOUDFLARE_UPSTREAM=false
MODEL_PROVIDER_POLICY=host-broker-only

# Public / Internal HTTP
PUBLIC_HTTP_ENABLED=true
PUBLIC_HTTP_HOST=0.0.0.0
PUBLIC_HTTP_PORT=7860
PUBLIC_HTTP_BODY_LIMIT_BYTES=1048576
# 逗号分隔的精确代理 IPv4/IPv6 地址；空值表示不信任任何代理。
# 仅当 socket peer 精确匹配时才读取 X-Forwarded-For 第一跳；同机 nginx 通常填 127.0.0.1,::1。
ADMIN_TRUSTED_PROXY_ADDRESSES=

INTERNAL_HTTP_ENABLED=true
INTERNAL_HTTP_HOST=127.0.0.1
INTERNAL_HTTP_PORT=8788
INTERNAL_HTTP_BODY_LIMIT_BYTES=262144

# OAuth（仅在 App manifest 启用时需要）
PUBLIC_BASE_URL=https://your-space-name.hf.space
OAUTH_TOKEN_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

# Storage / scheduling（容器和 HF 使用 /data/feishu-agent-platform；本地默认 ./data）
# Agent 的 workspace.root/sessionRoot 经 resolve 后必须等于或位于 DATA_ROOT 内。
DATA_ROOT=./data
PLATFORM_DATABASE_PATH=./data/platform.db
PLATFORM_CONFIG_ROOT=./config
INSTANCE_ID=
MAX_CONCURRENT_TURNS_GLOBAL=16
MAX_RESIDENT_PI_WORKERS=24
MAX_CONCURRENT_WORKER_STARTS=4
MAINTENANCE_INTERVAL_MS=30000

APP_SHARD_COUNT=1
APP_SHARD_INDEX=0
APP_LEASE_TTL_MS=45000
APP_LEASE_HEARTBEAT_MS=15000
