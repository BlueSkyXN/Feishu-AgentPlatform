{
  "name": "feishu-agent-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Configuration-driven Feishu App and Pi Agent platform with explicit N:N bindings.",
  "packageManager": "npm@10.9.4",
  "type": "module",
  "bin": {
    "feishu-agent-platform": "dist/cli/platformctl.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "clean": "node -e \"const fs=require('node:fs'); for (const path of ['dist','.test-dist','.offline-dist','coverage']) fs.rmSync(path,{recursive:true,force:true})\"",
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "postinstall": "node scripts/patch-pi-brace-expansion.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "node -e \"require('node:fs').rmSync('.test-dist',{recursive:true,force:true})\"",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js",
    "check": "npm run security:scan && npm run repository:check && npm run docs:check && npm run typecheck && npm test",
    "platformctl": "tsx src/cli/platformctl.ts",
    "security:scan": "node scripts/security-scan.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "repository:check": "node scripts/check-repository.mjs",
    "hf:preflight": "node scripts/hf-space-preflight.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "release:package": "node scripts/package-release.mjs",
    "ci": "npm run check && npm run build"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@larksuite/cli": "1.0.80",
    "@larksuiteoapi/node-sdk": "1.71.1",
    "brace-expansion": "5.0.8",
    "typebox": "1.3.8",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "brace-expansion": "$brace-expansion"
  }
}
