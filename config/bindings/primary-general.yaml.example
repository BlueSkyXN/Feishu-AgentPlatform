id: primary-general
enabled: true
app: primary
agent: general

route:
  default: true
  priority: 0
  commandPrefixes: []
  chatAllowlist: []
  userAllowlist: []
  threadAllowlist: []

conversation:
  scope: thread
  maxPendingTurns: 8
  idleTtlSeconds: 1800
  turnTimeoutSeconds: 300
  toolTimeoutSeconds: 60
  queuedTurnTtlSeconds: 300
  maxResidentSessions: 64
  maxConcurrentTurns: 4
  recentHistory:
    enabled: true
    maxMessages: 20
    maxCharacters: 30000
    currentThreadOnly: true
