id: primary-office
enabled: true
app: primary
agent: office

route:
  default: false
  priority: 100
  commandPrefixes:
    - /office
  chatAllowlist: []
  userAllowlist: []
  threadAllowlist: []

conversation:
  scope: thread
  maxPendingTurns: 8
  idleTtlSeconds: 1800
  turnTimeoutSeconds: 300
  toolTimeoutSeconds: 60
  queuedTurnTtlSeconds: 300
  maxResidentSessions: 64
  maxConcurrentTurns: 4
  recentHistory:
    enabled: true
    maxMessages: 30
    maxCharacters: 40000
    currentThreadOnly: true
